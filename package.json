{
  "name": "@openpowershift/oscd-editor-map-communication",
  "version": "0.0.0",
  "description": "OpenSCD editor plugin visualising GOOSE, Sampled Value and Report communication between IEDs on a single line diagram.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenPowerShift/oscd-editor-map-communication.git"
  },
  "bugs": {
    "url": "https://github.com/OpenPowerShift/oscd-editor-map-communication/issues"
  },
  "homepage": "https://openscd.org",
  "keywords": [
    "OpenSCD",
    "iec61850",
    "GOOSE",
    "SMV",
    "SampledValues",
    "Reports",
    "SLD",
    "communication"
  ],
  "license": "Apache-2.0",
  "exports": {
    ".": "./dist/oscd-editor-map-communication.js",
    "./oscd-editor-map-communication.js": "./dist/oscd-editor-map-communication.js"
  },
  "files": [
    "/dist/",
    "!/dist/**/*.spec.*",
    "!/dist/**/*.test.*",
    "!/dist/testing/**"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "oscd lint",
    "format": "oscd lint --format",
    "start": "oscd start",
    "start:bundle": "oscd start-bundle",
    "build": "oscd build",
    "bundle": "oscd bundle",
    "test": "oscd test",
    "test:watch": "oscd test --watch",
    "test:visual": "oscd test --visual",
    "test:update": "oscd test --update",
    "updates": "oscd updates",
    "deploy": "oscd deploy",
    "sample": "oscd build && node scripts/generate-sample.mjs",
    "prepare": "oscd install-hooks"
  },
  "dependencies": {
    "@lit/localize": "^0.12.2",
    "@omicronenergy/oscd-editor-sld": "^1.0.0",
    "@omicronenergy/oscd-ui": "^0.1.1",
    "@open-wc/scoped-elements": "^3.0.10",
    "@openscd/oscd-api": "^0.1.6",
    "@openscd/scl-lib": "^2.0.1",
    "@webcomponents/scoped-custom-element-registry": "^0.0.10",
    "lit": "^3.3.3",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@omicronenergy/oscd-menu-open": "^0.0.6",
    "@omicronenergy/oscd-menu-save": "^0.0.2",
    "@omicronenergy/oscd-shell": "^0.0.18",
    "@omicronenergy/oscd-tooling": "^0.0.8",
    "@open-wc/testing": "^4.0.0",
    "@web/test-runner-commands": "^0.9.0",
    "@web/test-runner-playwright": "^0.11.1",
    "@web/test-runner-visual-regression": "^0.10.0",
    "sinon": "^22.0.0"
  }
}
